# Server Port
PORT=5000

# Database Engine Selection: 'mysql'
DB_TYPE=mysql

# MySQL Configuration (For Local or Production Server e.g. cPanel, VPS, RDS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
