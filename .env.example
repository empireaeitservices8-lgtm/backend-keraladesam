# Server Port
PORT=5000

# Database Engine Selection: 'mysql' or 'mongodb'
DB_TYPE=mysql

# MySQL Configuration (For Local or Production Server e.g. cPanel, VPS, RDS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=keraladesam_db

# MongoDB Configuration (Fallback / optional)
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.neb4vpv.mongodb.net/KeralaDesham

# JWT Secret for Admin & Editor Authentication
JWTSecretKey=secretkey123
JWT_SECRET=secretkey123
