# Server Port
PORT=5000

# Database Engine Selection: 'mysql'
DB_TYPE=mysql

# MySQL Configuration (For Local Dev or Cloud Production Server e.g. TiDB, Aiven, Railway, AWS RDS, cPanel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=keraladesam_db
DB_SSL=false

# JWT Secret for Admin & Editor Authentication
JWTSecretKey=secretkey123
JWT_SECRET=secretkey123

# Cloudinary Media Storage (Recommended for free media hosting & auto-CDN delivery)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare R2 / CDN Configuration (Alternative high-speed media & assets)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=keraladesam-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.keraladesam.com
